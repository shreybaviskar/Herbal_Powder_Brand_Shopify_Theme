<footer class="site-footer">
  <div class="footer__container">
    
    <!-- Left Column: Copyright -->
    <div class="footer__block footer__copyright">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ "THE WORLD URBAN INGREDIENTS" | link_to: routes.root_url }}</p>
    </div>

    <!-- Center Column: Navigation Links -->
    <div class="footer__block footer__links">
      <ul class="footer__menu">
        {% for link in section.settings.menu.links %}
          <li>{{ link.title | link_to: link.url }}</li>
        {% endfor %}
      </ul>
    </div>

    <!-- Right Column: Social Media Icons -->
    <div class="footer__block footer__social">
      {%- if section.settings.social_instagram_link != blank -%}
        <a href="{{ section.settings.social_instagram_link }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.social_linkedin_link != blank -%}
        <a href="{{ section.settings.social_linkedin_link }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.social_tiktok_link != blank -%}
        <a href="{{ section.settings.social_tiktok_link }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.social_facebook_link != blank -%}
        <a href="{{ section.settings.social_facebook_link }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
      {%- endif -%}
    </div>
    
  </div>

  <div class="footer__payment-bar">
    {% if section.settings.show_payment_icons %}
      <div class="footer__payment-icons">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background-color: #ffffff;
    border-top: 1px solid #000;
    padding: 3rem 1.5rem 1rem 1.5rem;
    font-family: 'Courier New', Courier, monospace;
    color: #333;
  }

  .footer__container {
    max-width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr; /* Mobile layout: stacked vertically */
    gap: 2rem;
    text-align: center;
  }

  /* Desktop layout: 3 columns */
  @media (min-width: 768px) {
    .footer__container {
      grid-template-columns: 1fr 1fr 1fr;
      text-align: left;
      align-items: center;
    }
    .footer__copyright {
      text-align: left;
    }
    .footer__links {
      text-align: center;
    }
    .footer__social {
      text-align: right;
      justify-content: flex-end;
    }
  }

  .footer__copyright p {
    margin: 0;
    font-size: 0.9rem;
  }
  
  .footer__copyright a {
    color: inherit;
    text-decoration: none;
    font-weight: bold;
  }

  .footer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .footer__menu a {
    text-decoration: none;
    color: #333;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer__menu a:hover {
    color: #eba14e; /* Theme orange */
  }

  .footer__social {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    align-items: center;
  }

  .social-icon {
    color: #333;
    transition: opacity 0.2s ease, transform 0.2s ease;
    display: inline-flex;
  }

  .social-icon:hover {
    opacity: 0.7;
    transform: translateY(-2px);
  }

  .footer__payment-bar {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
    display: flex;
    justify-content: center;
  }

  .footer__payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .footer__payment-icons svg {
    width: 38px;
    height: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "social_linkedin_link",
      "label": "LinkedIn link"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "TikTok link"
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Facebook link"
    }
  ]
}
{% endschema %}