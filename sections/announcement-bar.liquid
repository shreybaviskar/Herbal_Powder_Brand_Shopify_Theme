{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar__link">
    {%- endif -%}
      <p class="announcement-bar__message">
        {{ section.settings.text | escape }}
        {%- if section.settings.link != blank -%}
          <span class="announcement-bar__arrow">&rarr;</span>
        {%- endif -%}
      </p>
    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  .announcement-bar {
    text-align: center;
    padding: 10px 20px;
    font-size: 14px;
    font-family: sans-serif;
    letter-spacing: 0.5px;
  }
  .announcement-bar__link {
    text-decoration: none;
    color: inherit;
  }
  .announcement-bar__message {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Welcome to our store, where nature's bounty fills your pantry!"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#060d14"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}