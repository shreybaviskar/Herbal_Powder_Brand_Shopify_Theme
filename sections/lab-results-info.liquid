<div class="lab-info section-{{ section.id }}">
  <div class="lab-info__container">
    
    {% if section.settings.heading != blank %}
      <h2 class="lab-info__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.content != blank %}
      <div class="lab-info__content rte">
        {{ section.settings.content }}
      </div>
    {% endif %}
    
  </div>
</div>

{% stylesheet %}
  .lab-info {
    padding: 4rem 2rem;
    background-color: #ffffff;
    border-bottom: 1px solid #000;
  }

  .lab-info__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .lab-info__heading {
    font-size: 2.5rem;
    font-family: sans-serif;
    font-weight: 500;
    color: #000;
    margin: 0 0 2rem 0;
  }

  .lab-info__content {
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    line-height: 1.8;
    color: #333;
  }

  .lab-info__content p {
    margin-bottom: 1.5rem;
  }

  .lab-info__content ul {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }

  .lab-info__content li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    font-weight: bold;
  }

  .lab-info__content li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #000;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lab Results Info",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Peace of Mind"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>At Spice Profile, we believe that what goes into your food should be nothing but the best...</p>"
    }
  ],
  "presets": [
    {
      "name": "Lab Results Info"
    }
  ]
}
{% endschema %}