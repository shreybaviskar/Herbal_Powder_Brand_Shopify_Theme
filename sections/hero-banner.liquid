<div class="hero-banner">
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}" class="hero-banner__link">
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 3840 | image_tag: 
      class: 'hero-banner__image',
      loading: 'eager',
      widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' 
    }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner__placeholder' }}
  {%- endif -%}

  {%- if section.settings.link != blank -%}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .hero-banner {
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0; /* Removes the slight gap that can appear below block images */
  }

  .hero-banner__link {
    display: block;
    width: 100%;
  }

  .hero-banner__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .hero-banner__placeholder {
    width: 100%;
    height: 400px;
    background-color: #f4f4f4;
    fill: #ccc;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Full Width Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Image Link (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Full Width Hero Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}