<div class="product-recommendations section-{{ section.id }}">
  <div class="recommendations-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="recommendations__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    <div class="recommendations__grid">
      {%- for prod in collections.all.products -%}
        {%- if prod.id != product.id -%}
          <a href="{{ prod.url }}" class="product-card">
            <div class="product-card__image-wrapper">
              {%- if prod.featured_image != blank -%}
                <img src="{{ prod.featured_image | image_url: width: 400 }}" 
                     alt="{{ prod.featured_image.alt | escape }}" 
                     class="product-card__image" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <h3 class="product-card__title">{{ prod.title }}</h3>
            <div class="product-card__price">
              <span class="price-item--sale">{{ prod.price | money_with_currency }}</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .product-recommendations {
    margin-top: 4rem;
    border-top: 1px solid #eee;
    padding-top: 3rem;
    background-color: #ffffff;
  }

  .recommendations-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .recommendations__title {
    text-align: left;
    color: #333;
    font-family: sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .recommendations__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .recommendations__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .product-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: transform 0.2s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
  }

  .product-card__image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 100%; /* Square aspect ratio */
    margin-bottom: 0.75rem;
    background-color: #fcfcfc;
    border: 1px solid #eee;
  }

  .product-card__image,
  .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.75rem;
  }

  .product-card__title {
    font-size: 0.85rem;
    line-height: 1.3;
    font-family: sans-serif;
    font-weight: 400;
    margin: 0 0 0.5rem 0;
    color: #333;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__price {
    font-size: 0.85rem;
    font-family: monospace;
    color: var(--theme-orange, #eba14e);
    font-weight: bold;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}