<div class="collection-banner section-{{ section.id }} {% if section.settings.full_width %}collection-banner--full-width{% endif %}">
  <div class="collection-banner__container">
    
    {%- if section.settings.banner_link != blank -%}
      <a href="{{ section.settings.banner_link }}" class="collection-banner__wrapper" target="_blank" rel="noopener noreferrer">
    {%- else -%}
      <div class="collection-banner__wrapper">
    {%- endif -%}

      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: 
          class: 'collection-banner__image',
          loading: 'lazy',
          widths: '550, 750, 1100, 1500, 1780, 2000, 2400' 
        }}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collection-banner__image' }}
      {%- endif -%}

    {%- if section.settings.banner_link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .collection-banner {
    padding: 2rem;
    background-color: #ffffff;
  }

  /* Removes padding if the user wants the banner to touch the screen edges */
  .collection-banner--full-width {
    padding: 0;
  }
  
  .collection-banner__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .collection-banner--full-width .collection-banner__container {
    max-width: 100%;
  }

  .collection-banner__wrapper {
    display: block;
    width: 100%;
    /* Optional: Add a subtle hover effect to indicate it's clickable */
    transition: opacity 0.2s ease;
  }

  a.collection-banner__wrapper:hover {
    opacity: 0.95;
  }

  .collection-banner__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .placeholder-svg {
    width: 100%;
    height: 400px;
    background-color: #f4f4f4;
    fill: #ccc;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Clickable Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image",
      "info": "Upload your full-size graphic here."
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Link",
      "info": "Select the collection (or any page) this banner should open when clicked."
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make banner full width",
      "default": false,
      "info": "Uncheck to keep the banner aligned with your grid (1400px wide)."
    }
  ],
  "presets": [
    {
      "name": "Clickable Image Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}