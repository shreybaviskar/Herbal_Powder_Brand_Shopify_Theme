<div class="product-page">
  <div class="product-page__container">
    
    <!-- Product Media -->
    <div class="product-page__media">
      {%- if product.selected_or_first_available_variant.featured_image != blank -%}
        <img src="{{ product.selected_or_first_available_variant.featured_image | image_url: width: 1000 }}" 
             alt="{{ product.title | escape }}" 
             class="product-page__main-image"
             id="MainProductImage">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-page__main-image' }}
      {%- endif -%}
    </div>

    <!-- Product Info -->
    <div class="product-page__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'title' -%}
            <h1 class="product-page__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            
          {%- when 'price' -%}
            <div class="product-page__price" {{ block.shopify_attributes }}>
              {{ product.price | money_with_currency }}
            </div>
            
          {%- when 'buy_buttons' -%}
            <div class="product-page__form" {{ block.shopify_attributes }}>
              {% form 'product', product %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                
                <div class="product-page__quantity">
                  <label for="Quantity">Quantity</label>
                  <input type="number" id="Quantity" name="quantity" value="1" min="1">
                </div>
                
                <button type="submit" class="product-page__add-to-cart" {% unless product.available %}disabled{% endunless %}>
                  {% if product.available %}
                    Add to Cart
                  {% else %}
                    Sold Out
                  {% endif %}
                </button>
              {% endform %}
            </div>
            
          {%- when 'description' -%}
            <div class="product-page__description" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>
            
        {%- endcase -%}
      {%- endfor -%}
    </div>
    
  </div>
</div>

{% stylesheet %}
  .product-page {
    padding: 4rem 2rem;
    background-color: #ffffff;
  }

  .product-page__container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  @media screen and (min-width: 768px) {
    .product-page__container {
      flex-direction: row;
    }
  }

  .product-page__media,
  .product-page__info {
    flex: 1;
    width: 100%;
  }

  .product-page__main-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    border: 1px solid #eee;
  }

  .product-page__title {
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
    color: var(--theme-green, #678b6f);
  }

  .product-page__price {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--theme-orange, #eba14e);
    margin-bottom: 2rem;
  }

  .product-page__form {
    margin-bottom: 2rem;
    padding: 2rem 0;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
  }

  .product-page__quantity {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-page__quantity input {
    width: 100px;
    padding: 10px;
    border: 1px solid #ccc;
  }

  .product-page__add-to-cart {
    width: 100%;
    padding: 15px;
    background-color: var(--theme-orange, #eba14e);
    color: white;
    border: none;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }

  .product-page__add-to-cart:hover {
    opacity: 0.9;
  }

  .product-page__add-to-cart:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }

  .product-page__description {
    line-height: 1.6;
    color: #444;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Information",
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    }
  ]
}
{% endschema %}