<header class="site-header" style="background-color: {{ section.settings.bg_color }};">
  <div class="header-container">
    
    <!-- Mobile Menu Toggle (Hamburger) -->
    <button type="button" class="mobile-menu-toggle" id="MobileMenuToggle" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- Logo -->
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | img_url: 'master' }}" 
               alt="{{ shop.name }}" 
               class="header-logo__image">
        {%- else -%}
          <span class="logo-placeholder">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Navigation -->
    <nav class="header-nav" id="HeaderNav">
      <ul class="nav-list">
        {%- assign menu_linklist = section.settings.menu -%}
        
        {%- if menu_linklist == blank -%}
          {%- assign menu_linklist = linklists['main-menu'] -%}
        {%- endif -%}

        {%- for link in menu_linklist.links -%}
          <li class="nav-item {% if link.links.size > 0 %}has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="nav-link {% if link.active %}nav-link--active{% endif %}">
              {{ link.title }}
              {%- if link.links.size > 0 -%}
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg>
              {%- endif -%}
            </a>
            
            <!-- Sub-menu Dropdown -->
            {%- if link.links.size > 0 -%}
              <ul class="nav-dropdown">
                {%- for child_link in link.links -%}
                  <li class="nav-dropdown__item">
                    <a href="{{ child_link.url }}" class="nav-dropdown__link">{{ child_link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- else -%}
          <li class="nav-item"><span class="nav-link" style="color: red;">Please select a menu in Theme settings</span></li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Icons -->
    <div class="header-icons">
      
      <!-- Dropdown Search -->
      <div class="header-search">
        <button type="button" class="icon-link search-toggle" id="SearchToggle" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>

        <div class="search-dropdown" id="SearchDropdown">
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-dropdown__form">
            <input type="hidden" name="type" value="product,collection">
            <input type="hidden" name="options[prefix]" value="last">
            
            <input type="search" name="q" id="SearchDropdownInput" class="search-dropdown__input" placeholder="Search products or collections..." autocomplete="off">
            <button type="submit" class="search-dropdown__submit">Search</button>
          </form>
          
          <div class="search-dropdown__results" id="SearchDropdownResults" style="display: none;">
            <!-- Live predictive results will inject here -->
          </div>
        </div>
      </div>
      
      <!-- Account Icon -->
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-link">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </a>
      {%- endif -%}
      
      <!-- Cart Icon -->
      <a href="{{ routes.cart_url }}" class="icon-link">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </a>

    </div>

  </div>
</header>

<style>
  /* Base / Mobile-First Styles */
  .site-header {
    position: relative;
    border-bottom: 1px solid #000;
    padding: 10px 15px; 
    font-family: Courier, monospace; 
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
    flex-wrap: nowrap; /* Forces a single line layout */
    gap: 10px;
  }

  /* Hamburger Menu Button */
  .mobile-menu-toggle {
    display: block;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: #000;
  }

  .header-logo {
    flex: 1; /* Pushes icons to the right, stays centered between them */
    display: flex;
    justify-content: flex-start;
    padding-left: 10px;
  }

  .header-logo a {
    text-decoration: none;
    color: #000;
  }

  .header-logo__image {
    display: block;
    background: transparent;
    padding: 0;
    margin: 0;
    max-width: 100px !important; /* Constrains logo on mobile so icons fit cleanly */
  }

  /* Navigation Drawer (Mobile) */
  .header-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #000;
    z-index: 100;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
  }

  .header-nav.is-active {
    display: block;
  }

  .header-nav .nav-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 15px 20px;
    gap: 15px;
  }

  .nav-link {
    text-decoration: none;
    color: #333;
    font-size: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link--active {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Icons */
  .header-icons {
    display: flex;
    gap: 12px; /* Tighter gap for mobile */
    align-items: center;
  }

  .icon-link {
    color: #000;
    text-decoration: none;
    display: flex;
  }

  /* Search Dropdown Overrides */
  .header-search {
    position: static; /* Overridden for mobile to use full width */
    display: flex;
    align-items: center;
  }

  .search-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .search-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    width: 100%;
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    padding: 1.5rem;
    z-index: 100;
  }

  .search-dropdown.is-active {
    display: block;
  }

  .search-dropdown__form {
    display: flex;
    gap: 10px;
    margin-bottom: 1rem;
  }

  .search-dropdown__input {
    flex: 1;
    padding: 10px;
    border: 1px solid #ccc;
    font-family: sans-serif;
    font-size: 0.9rem;
  }

  .search-dropdown__input:focus {
    outline: none;
    border-color: #678b6f;
  }

  .search-dropdown__submit {
    background-color: #eba14e;
    color: #fff;
    border: none;
    padding: 10px 15px;
    cursor: pointer;
    font-family: sans-serif;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 0.8rem;
  }

  .search-dropdown__results {
    max-height: 400px;
    overflow-y: auto;
  }

  /* Predictive Search Results Styles */
  .predictive-group { margin-bottom: 1.5rem; }
  .predictive-group h4 { margin: 0 0 0.5rem 0; font-size: 0.85rem; color: #678b6f; text-transform: uppercase; border-bottom: 1px solid #eee; padding-bottom: 0.25rem; }
  .predictive-group ul { list-style: none; padding: 0; margin: 0; }
  .predictive-group li { margin-bottom: 0.5rem; }
  .predictive-collection { text-decoration: none; color: #333; font-size: 0.9rem; font-family: sans-serif; }
  .predictive-collection:hover { color: #eba14e; }
  .predictive-product { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #333; }
  .predictive-product img { width: 50px; height: 50px; object-fit: cover; background: #f4f4f4; }
  .predictive-product__info { display: flex; flex-direction: column; }
  .predictive-product__title { font-size: 0.85rem; font-family: sans-serif; }
  .predictive-product__price { font-size: 0.8rem; color: #eba14e; font-weight: bold; font-family: monospace; }
  .predictive-empty { font-family: sans-serif; font-size: 0.9rem; color: #666; text-align: center; padding: 1rem 0; }

  /* Desktop Adjustments */
  @media (min-width: 768px) {
    .site-header {
      padding: 0 40px; 
    }
    
    .mobile-menu-toggle {
      display: none; /* Hides hamburger on desktop */
    }

    .header-logo {
      flex: none;
      padding-left: 0;
    }

    .header-logo__image {
      max-width: {{ section.settings.logo_max_width }}px !important; 
    }
    
    .header-nav {
      display: flex;
      position: static;
      width: auto;
      border: none;
      box-shadow: none;
      margin-left: 48px; 
      margin-right: auto;
    }
    
    .header-nav .nav-list {
      flex-direction: row;
      gap: 38px; 
      padding: 0;
    }
    
    .header-icons {
      gap: 24px; 
    }

    .header-search {
      position: relative; 
    }

    .search-dropdown {
      top: 150%;
      left: auto;
      right: 0;
      width: 350px;
      border: 1px solid #e0e0e0;
    }
  }

  /* --- Dropdown Menu Styles --- */
  .nav-item.has-dropdown {
    position: relative;
  }
  
  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    padding: 10px 0;
    min-width: 200px;
    list-style: none;
    margin: 0;
    z-index: 200;
  }
  
  /* Show dropdown on hover (desktop) or when active (mobile) */
  .nav-item.has-dropdown:hover .nav-dropdown,
  .nav-item.has-dropdown.is-open .nav-dropdown {
    display: block;
  }
  
  .nav-dropdown__item {
    padding: 0;
  }
  
  .nav-dropdown__link {
    display: block;
    padding: 10px 20px;
    text-decoration: none;
    color: #333;
    font-family: sans-serif;
    font-size: 14px;
    transition: background-color 0.2s, color 0.2s;
    text-align: left;
  }
  
  .nav-dropdown__link:hover {
    background-color: #f9f9f9;
    color: #eba14e; /* Theme Orange */
  }
  
  /* Mobile drawer adjustments for the dropdown */
  @media screen and (max-width: 767px) {
    .nav-item.has-dropdown {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }
    
    .nav-dropdown {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      border-left: 2px solid #eba14e;
      margin-top: 10px;
      margin-left: 10px;
      padding: 0;
      min-width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    
    // --- Mobile Dropdown Menu Toggle (Link Disabled on Mobile) ---
    const dropdownLinks = document.querySelectorAll('.nav-item.has-dropdown > a');
    
    dropdownLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        // Only intercept and disable the link on mobile screen widths
        if (window.innerWidth <= 767) {
          e.preventDefault(); // Completely disables the link navigation on mobile
          
          const parentLi = this.parentElement;
          
          // Toggle the dropdown open or closed
          if (parentLi.classList.contains('is-open')) {
            parentLi.classList.remove('is-open');
          } else {
            // Close any other open dropdowns first
            document.querySelectorAll('.nav-item.has-dropdown').forEach(item => {
              item.classList.remove('is-open');
            });
            // Open the tapped dropdown
            parentLi.classList.add('is-open');
          }
        }
      });
    });

    // --- Mobile Menu Drawer Toggle (Hamburger) ---
    const mobileMenuBtn = document.getElementById('MobileMenuToggle');
    const headerNav = document.getElementById('HeaderNav');
    
    if (mobileMenuBtn && headerNav) {
      mobileMenuBtn.addEventListener('click', function(e) {
        e.preventDefault();
        headerNav.classList.toggle('is-active');
        // Close search if open
        const dropdown = document.getElementById('SearchDropdown');
        if (dropdown && dropdown.classList.contains('is-active')) {
          dropdown.classList.remove('is-active');
        }
      });
    }

    // --- Search Dropdown Logic ---
    const toggleBtn = document.getElementById('SearchToggle');
    const dropdown = document.getElementById('SearchDropdown');
    const input = document.getElementById('SearchDropdownInput');
    const resultsContainer = document.getElementById('SearchDropdownResults');
    let debounceTimer;

    if (!toggleBtn || !dropdown || !input || !resultsContainer) return;

    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      dropdown.classList.toggle('is-active');
      if (dropdown.classList.contains('is-active')) {
        input.focus();
        // Close mobile menu if open
        if (headerNav && headerNav.classList.contains('is-active')) {
          headerNav.classList.remove('is-active');
        }
      }
    });

    document.addEventListener('click', function(e) {
      if (!dropdown.contains(e.target) && !toggleBtn.contains(e.target)) {
        dropdown.classList.remove('is-active');
      }
    });

    // Handle LIVE typing (Dynamic Search)
    input.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      const query = this.value.trim();

      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        resultsContainer.style.display = 'none';
        return;
      }

      resultsContainer.innerHTML = '<div class="predictive-empty">Searching...</div>';
      resultsContainer.style.display = 'block';

      debounceTimer = setTimeout(() => {
        const fetchUrl = `/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product,collection&resources[limit]=6&resources[options][prefix]=last&resources[options][unavailable_products]=hide`;

        fetch(fetchUrl)
          .then(response => {
            if (!response.ok) throw new Error('Network error');
            return response.json();
          })
          .then(data => {
            const products = data.resources.results.products || [];
            const collections = data.resources.results.collections || [];
            let html = '';

            if (collections.length > 0) {
              html += '<div class="predictive-group"><h4>Collections</h4><ul>';
              collections.forEach(collection => {
                html += `<li><a href="${collection.url}" class="predictive-collection">${collection.title}</a></li>`;
              });
              html += '</ul></div>';
            }

            if (products.length > 0) {
              html += '<div class="predictive-group"><h4>Products</h4><ul>';
              products.forEach(product => {
                html += `<li>
                           <a href="${product.url}" class="predictive-product">
                             ${product.image ? `<img src="${product.image}" alt="">` : ''}
                             <div class="predictive-product__info">
                               <span class="predictive-product__title">${product.title}</span>
                               <span class="predictive-product__price">${product.price}</span>
                             </div>
                           </a>
                         </li>`;
              });
              html += '</ul></div>';
            }

            if (html === '') {
              html = '<div class="predictive-empty">No results found for "' + query + '"</div>';
            }

            resultsContainer.innerHTML = html;
          })
          .catch(error => {
            resultsContainer.innerHTML = '<div class="predictive-empty">Error loading results. Please press Enter to search.</div>';
          });
      }, 300);
    });
  });
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Custom logo width",
      "default": 120
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}      
