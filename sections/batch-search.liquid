<div class="batch-search section-{{ section.id }}">
  <div class="batch-search__container">
    
    <form id="BatchSearchForm" class="batch-search__form" onsubmit="event.preventDefault(); openBatchReport();">
      <input 
        type="text" 
        id="BatchNumberInput" 
        class="batch-search__input" 
        placeholder="{{ section.settings.placeholder_text }}" 
        autocomplete="off"
        required
      >
      <button type="submit" class="batch-search__submit" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </form>
    
    <p id="BatchSearchError" class="batch-search__error" style="display: none;">Please enter a valid batch number.</p>
    
  </div>
</div>

<!-- Hidden input to dynamically grab your store's Shopify Files CDN URL -->
<input type="hidden" id="ShopifyFilesBase" value="{{ 'dummy-file.pdf' | file_url | split: 'dummy-file.pdf' | first }}">

<script>
  async function openBatchReport() {
    const input = document.getElementById('BatchNumberInput').value;
    const errorMsg = document.getElementById('BatchSearchError');
    const submitBtn = document.querySelector('.batch-search__submit');
    let baseUrl = document.getElementById('ShopifyFilesBase').value;

    // Ensure baseUrl starts with https: if it starts with //
    if (baseUrl.startsWith('//')) {
      baseUrl = 'https:' + baseUrl;
    }

    // Clean the input: trim spaces, uppercase, and replace forward slashes with dashes
    const sanitizedBatch = input.trim().toUpperCase().replace(/\//g, '-');

    if (!sanitizedBatch) {
      errorMsg.innerText = "Please enter a batch number.";
      errorMsg.style.display = 'block';
      return;
    }

    // Hide error and show loading state
    errorMsg.style.display = 'none';
    submitBtn.style.opacity = '0.5';
    submitBtn.style.pointerEvents = 'none';

    // Construct the final PDF URL
    const pdfUrl = baseUrl + sanitizedBatch + '.pdf';

    try {
      // Ping the server to see if the file actually exists
      const response = await fetch(pdfUrl, { method: 'HEAD' });
      
      if (response.ok) {
        // File exists! Open it in a new tab.
        window.open(pdfUrl, '_blank');
      } else {
        // File not found (404)
        errorMsg.innerText = "Batch number not found. Please check the code and try again.";
        errorMsg.style.display = 'block';
      }
    } catch (error) {
      // Fallback for network issues
      errorMsg.innerText = "Unable to connect. Please check your internet connection.";
      errorMsg.style.display = 'block';
    }

    // Restore button state
    submitBtn.style.opacity = '1';
    submitBtn.style.pointerEvents = 'auto';
  }
</script>

{% stylesheet %}
  .batch-search {
    padding: 4rem 2rem;
    background-color: #ffffff;
    display: flex;
    justify-content: center;
  }

  .batch-search__container {
    width: 100%;
    max-width: 800px; /* Matches the width in your reference image */
  }

  .batch-search__form {
    display: flex;
    align-items: center;
    border: 1px solid #000;
    background-color: #fff;
    padding: 5px;
  }

  .batch-search__input {
    flex: 1;
    border: none;
    padding: 15px 20px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: #333;
    outline: none;
    background: transparent;
  }

  .batch-search__input::placeholder {
    color: #999;
  }

  .batch-search__submit {
    background: transparent;
    border: none;
    padding: 10px 20px;
    cursor: pointer;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  .batch-search__submit:hover {
    opacity: 0.6;
  }

  .batch-search__error {
    color: #d9534f;
    font-family: sans-serif;
    font-size: 0.9rem;
    margin-top: 10px;
    text-align: left;
    padding-left: 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Batch Search Bar",
  "settings": [
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder Text",
      "default": "Enter Batch Number"
    }
  ],
  "presets": [
    {
      "name": "Batch Search Bar"
    }
  ]
}
{% endschema %}