<div class="bulk-info section-{{ section.id }}">
  <div class="bulk-info__container">
    
    {%- if section.settings.heading != blank -%}
      <h2 class="bulk-info__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.message != blank -%}
      <div class="bulk-info__message rte">
        {{ section.settings.message }}
      </div>
    {%- endif -%}
    
  </div>
</div>

{% stylesheet %}
  :root {
    --theme-orange: #eba14e;
    --theme-green: #678b6f;
  }

  .bulk-info {
    padding: 2rem;
    background-color: #ffffff;
  }

  .bulk-info__container {
    max-width: 800px;
    margin: 0 auto;
    background-color: #fcfcfc;
    border: 1px solid #eee;
    border-left: 5px solid var(--theme-orange);
    padding: 2rem;
    text-align: center;
  }

  .bulk-info__heading {
    color: var(--theme-green);
    font-family: sans-serif;
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
    font-weight: 600;
  }

  .bulk-info__message {
    color: #444;
    font-family: sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
  }

  .bulk-info__message p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bulk Orders Info",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Interested in Bulk Orders?"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>We offer special pricing for wholesale and bulk purchases. Please mention your estimated quantity and product requirements in the message below.</p>"
    }
  ],
  "presets": [
    {
      "name": "Bulk Orders Info",
      "category": "Text"
    }
  ]
}
{% endschema %}