<div class="lab-hero section-{{ section.id }}">
  <div class="lab-hero__container">
    
    <!-- Text Column -->
    <div class="lab-hero__text-col">
      <div class="lab-hero__content">
        {% if section.settings.heading != blank %}
          <h1 class="lab-hero__heading">{{ section.settings.heading }}</h1>
        {% endif %}
        
        {% if section.settings.intro_text != blank %}
          <div class="lab-hero__intro">
            {{ section.settings.intro_text }}
          </div>
        {% endif %}
        
        {% if section.settings.steps_heading != blank %}
          <h3 class="lab-hero__steps-heading">{{ section.settings.steps_heading }}</h3>
        {% endif %}

        <div class="lab-hero__steps">
          {% for block in section.blocks %}
            <div class="lab-step">
              <span class="lab-step__number">{{ forloop.index }}</span>
              <p class="lab-step__text">{{ block.settings.step_text }}</p>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.outro_text != blank %}
          <div class="lab-hero__outro">
            {{ section.settings.outro_text }}
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Image Column -->
    <div class="lab-hero__image-col">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'lab-hero__image', loading: 'lazy' }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg lab-hero__image' }}
      {% endif %}
    </div>

  </div>
</div>

{% stylesheet %}
  .lab-hero {
    padding: 0;
    background-color: #ffffff;
    border-bottom: 1px solid #000;
  }

  .lab-hero__container {
    display: flex;
    flex-direction: column;
    max-width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .lab-hero__container {
      flex-direction: row;
    }
  }

  .lab-hero__text-col,
  .lab-hero__image-col {
    flex: 1;
    width: 100%;
  }

  @media (min-width: 768px) {
    .lab-hero__text-col,
    .lab-hero__image-col {
      width: 50%;
    }
    .lab-hero__image-col {
      border-left: 1px solid #000;
    }
  }

  .lab-hero__text-col {
    padding: 4rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .lab-hero__content {
    max-width: 500px;
    font-family: 'Courier New', Courier, monospace;
    color: #333;
  }

  .lab-hero__heading {
    font-size: 2.2rem;
    line-height: 1.2;
    margin: 0 0 1.5rem 0;
    color: #000;
    font-family: sans-serif;
    font-weight: 600;
  }

  .lab-hero__intro,
  .lab-hero__outro {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .lab-hero__steps-heading {
    font-size: 1.1rem;
    margin: 2rem 0 1rem 0;
    color: #000;
  }

  .lab-hero__steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .lab-step {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .lab-step__number {
    background-color: #8bb2e8;
    color: #fff;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    flex-shrink: 0;
  }

  .lab-step__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .lab-hero__image-col {
    display: flex;
  }

  .lab-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 400px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lab Results Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Test Results for Your Product"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Introductory Text",
      "default": "<p>We are committed to radical transparency...</p>"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Steps Heading",
      "default": "How It Works"
    },
    {
      "type": "richtext",
      "id": "outro_text",
      "label": "Outro Text",
      "default": "<p>With Spice Profile, you don't have to wonder about the quality of your ingredients...</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Instruction Step",
      "settings": [
        {
          "type": "textarea",
          "id": "step_text",
          "label": "Step Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lab Results Hero"
    }
  ]
}
{% endschema %}