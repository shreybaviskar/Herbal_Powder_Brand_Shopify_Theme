<div class="contact-page section-{{ section.id }}">
  <div class="contact-page__container">
    <header class="contact-page__header">
      <h1 class="contact-page__title">{{ page.title | escape }}</h1>
    </header>

    {%- if page.content != blank -%}
      <div class="contact-page__content rte">
        {{ page.content }}
      </div>
    {%- endif -%}

    <div class="contact-page__form-wrapper">
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="contact-form__success">Thanks for contacting us. We'll get back to you as soon as possible.</div>
        {%- elsif form.errors -%}
          <div class="contact-form__error">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="ContactForm-name">Name <span class="required">*</span></label>
            <input
              type="text"
              id="ContactForm-name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              aria-required="true"
              required
              placeholder="Your Name"
            >
          </div>
          <div class="contact-form__field">
            <label for="ContactForm-email">Email <span class="required">*</span></label>
            <input
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              required
              placeholder="Your Email"
            >
          </div>
        </div>

        <div class="contact-form__field">
          <label for="ContactForm-phone">Phone number</label>
          <input
            type="tel"
            id="ContactForm-phone"
            name="contact[phone]"
            pattern="[0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="Your Phone Number"
          >
        </div>

        <div class="contact-form__field">
          <label for="ContactForm-body">Message <span class="required">*</span></label>
          <textarea
            rows="8"
            id="ContactForm-body"
            name="contact[body]"
            aria-required="true"
            required
            placeholder="How can we help you?"
          >{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>

        <div class="contact-form__submit">
          <button type="submit" class="contact-form__button">Send Message</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  :root {
    --theme-orange: #eba14e;
    --theme-green: #678b6f;
  }

  .contact-page {
    padding: 4rem 2rem;
    background-color: #ffffff;
  }

  .contact-page__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-page__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .contact-page__title {
    font-size: 2.5rem;
    font-family: sans-serif;
    font-weight: 600;
    color: var(--theme-green);
    margin: 0;
    display: inline-block;
    border-bottom: 3px solid var(--theme-orange);
    padding-bottom: 0.5rem;
  }

  .contact-page__content {
    font-family: sans-serif;
    line-height: 1.6;
    color: #333;
    font-size: 1.05rem;
    margin-bottom: 3rem;
    text-align: center;
  }

  .contact-page__form-wrapper {
    background-color: #fcfcfc;
    padding: 3rem;
    border: 1px solid #eee;
  }

  .contact-form__row {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .contact-form__row .contact-form__field {
    flex: 1 1 calc(50% - 0.75rem);
    min-width: 250px;
  }

  .contact-form__field {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .contact-form__field label {
    margin-bottom: 0.5rem;
    font-family: sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
  }

  .contact-form__field .required {
    color: red;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ccc;
    font-family: sans-serif;
    font-size: 1rem;
    background-color: #fff;
    transition: border-color 0.2s ease;
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--theme-green);
  }

  .contact-form__submit {
    margin-top: 2rem;
    text-align: center;
  }

  .contact-form__button {
    background-color: var(--theme-orange);
    color: #ffffff;
    padding: 15px 40px;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    font-family: sans-serif;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
    width: 100%;
  }

  @media screen and (min-width: 768px) {
    .contact-form__button {
      width: auto;
    }
  }

  .contact-form__button:hover {
    opacity: 0.8;
  }

  .contact-form__success {
    background-color: #e6f4ea;
    color: #1e4620;
    padding: 1rem;
    margin-bottom: 2rem;
    border: 1px solid #cce8d1;
    text-align: center;
    font-family: sans-serif;
  }

  .contact-form__error {
    background-color: #fce8e6;
    color: #c5221f;
    padding: 1rem;
    margin-bottom: 2rem;
    border: 1px solid #fad2cf;
    font-family: sans-serif;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "header",
      "content": "Contact Form Settings"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
